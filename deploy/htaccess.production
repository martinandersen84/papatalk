# PRODUCTION .htaccess — the deploy workflow uploads this file as .htaccess.
# The repository's own .htaccess stays in development mode (no cache).

<IfModule mod_headers.c>
  # Pages, service worker, manifest and data: always revalidate so a release shows up at once.
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Pictograms, icons and fonts: cache for a week (sw.js reloads them on each release).
  <FilesMatch "\.(png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType font/woff2 .woff2
</IfModule>

# State file written by the FTP deploy action: not public.
<IfModule mod_authz_core.c>
  <Files ".ftp-deploy-sync-state.json">
    Require all denied
  </Files>
</IfModule>

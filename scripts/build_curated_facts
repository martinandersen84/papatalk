def main():
    grouped = {}
    for category, entries in FACTS.items():
        tone = "humor blanco" if category == "humor" else "curioso"
        grouped[category] = [
            {
                "id": f"{category}_{index:04d}",
                "category": category,
                "text": text,
                "tone": tone,
                "safe": True,
                "source": source,
            }
            for index, (text, source) in enumerate(entries, start=1)
        ]
    Path("data/facts/facts.json").write_text(
        json.dumps(grouped, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

if __name__ == "__main__":
    main()
